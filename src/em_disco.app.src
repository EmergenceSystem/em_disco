{application, em_disco, [
    {description, "em_disco — Population Protocol super-node for peer discovery"},
    {vsn, "1.0.0"},
    {registered, [em_disco_sup]},
    {mod, {em_disco_app, []}},
    {applications, [
        kernel,
        stdlib,
        em_filter,
        cowboy
    ]},
    {env, [
        {gossip_port, 9100},
        {pop_seeds,   []},
        {http_port,   9080}
    ]},
    {modules, [
        em_disco_app,
        em_disco_sup,
        em_disco_health,
        em_disco_relay
    ]},
    {licenses, ["Apache 2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/em_disco"}]}
]}.

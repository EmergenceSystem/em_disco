{application, em_disco, [
    {description, "em_disco — Population Protocol super-node for peer discovery"},
    {vsn, "1.0.0"},
    {registered, [em_disco_sup]},
    {mod, {em_disco_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {gossip_port, 9100},
        {query_port,  9101},
        {pop_seeds,   []}
    ]},
    {modules, [
        em_disco_app,
        em_disco_sup,
        em_disco_query_handler
    ]},
    {licenses, ["Apache 2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/em_disco"}]}
]}.

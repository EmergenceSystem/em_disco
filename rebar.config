{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.9.0"},
    {jsx, "3.1.0"},
    {embryo, "0.2.0"}
]}.

{shell, [
    % {config, "config/sys.config"},
    {apps, [em_disco]}
]}.

{relx, [
    {release, {em_disco, "0.1.0"}, [
        em_disco,
        sasl,
        inets
    ]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]}
]}.

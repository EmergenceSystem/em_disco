{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.12.0"},
    {jose, "1.11.10"}
]}.

{shell, [
    {config, "config/sys.config"},
    {apps, [em_disco]}
]}.

{relx, [
    {release, {em_disco, "0.1.0"}, [
        em_disco,
        sasl,
        inets
    ]},
    {sys_config, "config/sys.config"},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {test, [
        {deps, [{gun, "2.1.0"}]}
    ]},
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]}
]}.

{ct_opts, [
    {sys_config, "config/test.sys.config"}
]}.

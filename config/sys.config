[{em_disco, [
    {port, 8080},
    {require_auth, false},
    {jwt_secret, <<"CHANGE_ME_IN_PRODUCTION">>},
    {rate_limit_per_second, 10},
    {rate_limit_burst, 30},
    {rate_limit_localhost, 1000},
    {ws_idle_timeout, 60000},
    {query_timeout_ms, 5000}
]},
{jose, [
    {json_module, jose_json_otp}
]},
{kernel, [
    {logger_level, notice}
]}].
